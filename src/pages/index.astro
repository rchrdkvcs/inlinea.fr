---
import Layout from "../layouts/Layout.astro";
import Brand from "../components/Brand.astro";
import Header from "../components/Header.astro";
import {
  ArrowUpRight,
  ArrowDown,
  ArrowUp,
  ArrowRight,
  Asterisk,
  MousePointer2,
  Check,
  Lightbulb,
  MessagesSquare,
  PenTool,
  Code2,
} from "@lucide/astro";
const services = [
  {
    number: "01",
    type: "design",
    title: "Du sens. Et du caractère.",
    name: "Design produit",
    text: "Une identité reconnaissable, des interfaces claires et une expérience qui donne envie de revenir.",
    tags: ["Identité visuelle", "UI/UX", "Prototypage"],
    href: "/expertises/design-produit/",
  },
  {
    number: "02",
    type: "code",
    title: "Bien pensé. Bien développé.",
    name: "Sites & applications",
    text: "Du site vitrine à l’application web, des produits rapides, accessibles et simples à faire évoluer.",
    tags: ["Sites web", "Applications", "Développement"],
    href: "/expertises/sites-applications-web/",
  },
  {
    number: "03",
    type: "tools",
    title: "Moins de friction. Plus d’action.",
    name: "Outils sur mesure",
    text: "Des automatisations et des outils métier adaptés à votre quotidien. Pas l’inverse.",
    tags: ["Automatisation", "Google Sheets", "API"],
    href: "/expertises/outils-sur-mesure/",
  },
];
const steps = [
  {
    title: "On pose les bonnes questions.",
    name: "Cadrer",
    icon: MessagesSquare,
    outcome: "Un cap clair et des priorités partagées",
    text: "Votre besoin, vos utilisateurs, vos contraintes. On définit ensemble un cap clair et les priorités du projet.",
  },
  {
    title: "On donne forme à votre idée.",
    name: "Concevoir",
    icon: PenTool,
    outcome: "Un prototype pour se projeter",
    text: "Des premières pistes aux prototypes, vous voyez le projet prendre forme et participez aux choix.",
  },
  {
    title: "On construit pour la suite.",
    name: "Développer",
    icon: Code2,
    outcome: "Un produit testé, prêt à être utilisé",
    text: "On développe, on teste et on affine. Puis on met en ligne une solution que vous pouvez prendre en main.",
  },
];
---

<Layout
  title="Studio design & développement web à Rennes | Inlinea"
  description="Inlinea est un studio indépendant à Rennes. Design produit, création de sites et d’applications web, outils numériques sur mesure et automatisation."
>
  <a class="skip-link" href="#main">
    Aller au contenu
  </a>
  <Header />
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero-inner">
        <p class="eyebrow hero-eyebrow">
          <span class="small-cross" aria-hidden="true">
            <Asterisk size={20} aria-hidden="true" />
          </span>{" "}
          Studio indépendant · Rennes, Bretagne
        </p>
        <h1 id="hero-title">
          Studio de design & développement web à Rennes.
          <br />
          <span>Sans détour.</span>
        </h1>
        <p class="hero-description">
          Design, sites, applications et outils sur mesure.
          <br class="desktop-break" /> On donne vie à vos idées, avec du sens et
          du soin.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="mailto:bonjour@inlinea.fr">
            Construisons votre projet{" "}
            <ArrowUpRight size={18} aria-hidden="true" />
          </a>
          <a class="button button-secondary" href="#services">
            Explorer nos expertises <ArrowDown size={18} aria-hidden="true" />
          </a>
        </div>
        <div
          class="blueprint"
          role="img"
          aria-label="De votre idée au produit : design, développement et mise en ligne, réunis par Inlinea."
        >
          <div class="blueprint-meta">
            <span>INLINEA / DE L’IDÉE AU RÉEL</span>
            <span>DESIGN + CODE + UN PEU D’AUDACE</span>
          </div>
          <div class="blueprint-flow" aria-hidden="true">
            <div class="idea-note">
              <span class="mono">01 / LE DÉCLIC</span>
              <Lightbulb size={62} aria-hidden="true" />
              <strong>
                Et si on faisait
                <br />
                autrement ?
              </strong>
              <span class="note-scribble">Tout commence ici.</span>
            </div>
            <span class="flow-arrow">
              <ArrowRight size={40} strokeWidth={1.5} aria-hidden="true" />
            </span>
            <div class="build-stack">
              <div class="stack-offset"></div>
              <div class="build-card">
                <div class="panel-heading">
                  <span>02 / LA FABRIQUE</span>
                  <span>
                    <Asterisk size={20} aria-hidden="true" />
                  </span>
                </div>
                <div class="design-row">
                  <span class="design-symbol">Aa</span>
                  <div class="swatches">
                    <i></i>
                    <i></i>
                    <i></i>
                  </div>
                  <span class="cursor">
                    <MousePointer2 size={30} aria-hidden="true" />
                  </span>
                </div>
                <div class="code-lines">
                  <span>
                    <b>&lt;idée&gt;</b>
                  </span>
                  <span>
                    &nbsp; design: <em>intentionnel</em>;
                  </span>
                  <span>
                    &nbsp; code: <em>bien construit</em>;
                  </span>
                  <span>
                    <b>&lt;/produit&gt;</b>
                  </span>
                </div>
                <div class="build-footer">
                  <span>Design + Développement</span>
                  <span>
                    <ArrowUpRight size={16} aria-hidden="true" />
                  </span>
                </div>
              </div>
            </div>
            <span class="flow-arrow">
              <ArrowRight size={40} strokeWidth={1.5} aria-hidden="true" />
            </span>
            <div class="product-window">
              <div class="product-toolbar">
                <div>
                  <i></i>
                  <i></i>
                  <i></i>
                </div>
                <span>votre-projet.fr</span>
                <span>
                  <ArrowUpRight size={16} aria-hidden="true" />
                </span>
              </div>
              <div class="product-content">
                <span class="product-label">03 / VOTRE PROCHAIN CHAPITRE</span>
                <div class="product-composition">
                  <div class="product-headline">
                    Ça prend
                    <br />
                    forme<span>.</span>
                    <div class="mock-cta">
                      Et ça change tout.{" "}
                      <ArrowUpRight size={16} aria-hidden="true" />
                    </div>
                  </div>
                  <div class="product-sculpture">
                    <i></i>
                    <i></i>
                    <i></i>
                    <i></i>
                  </div>
                </div>
                <div class="product-bottom">
                  <span>Conçu avec soin.</span>
                  <span>Prêt pour la suite.</span>
                </div>
              </div>
              <div class="live-label">
                <span></span> Votre idée, en ligne.
              </div>
            </div>
          </div>
          <div class="blueprint-baseline" aria-hidden="true">
            <span>UNE VISION CLAIRE</span>
            <span>UN INTERLOCUTEUR UNIQUE</span>
            <span>UN PRODUIT QUI VOUS RESSEMBLE</span>
          </div>
        </div>
      </div>
    </section>
    <div class="expertise-strip">
      <div class="container">
        <span>De la réflexion à l’action.</span>
        <span>
          Design{" "}
          <i>
            <Asterisk size={20} aria-hidden="true" />
          </i>{" "}
          Développement{" "}
          <i>
            <Asterisk size={20} aria-hidden="true" />
          </i>{" "}
          Automatisation
        </span>
      </div>
    </div>
    <section
      class="section services"
      id="services"
      aria-labelledby="services-title"
    >
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">01 / Nos expertises</p>
            <h2 id="services-title">
              Les bonnes briques.
              <br />
              Le bon produit.
            </h2>
          </div>
          <p class="section-copy">
            Un site à lancer, une expérience à repenser, un quotidien à
            simplifier. On assemble ce qu’il vous faut, sans complexité inutile.
          </p>
        </div>
        <div class="service-grid">
          {services.map((service) => (
            <article class="service-card">
              <div class={`service-art art-${service.type}`} aria-hidden="true">
                {service.type === "design" ? (
                  <>
                    <div class="type-tile">
                      Aa<span>LE FOND + LA FORME</span>
                    </div>
                    <div class="color-tile">
                      <i></i>
                      <i></i>
                      <i></i>
                    </div>
                    <span class="art-cursor">
                      <MousePointer2 size={30} aria-hidden="true" />
                    </span>
                  </>
                ) : service.type === "code" ? (
                  <div class="code-tile">
                    <div>
                      <i></i>
                      <i></i>
                      <i></i>
                    </div>
                    <strong>
                      &lt;<span> / </span>&gt;
                    </strong>
                    <span>Une base solide.</span>
                  </div>
                ) : (
                  <div class="nodes">
                    <span>
                      <ArrowUpRight size={16} aria-hidden="true" />
                    </span>
                    <i></i>
                    <span>
                      <Asterisk size={20} aria-hidden="true" />
                    </span>
                    <i></i>
                    <span>
                      <Check size={26} aria-hidden="true" />
                    </span>
                    <small>Tout se connecte.</small>
                  </div>
                )}
              </div>
              <div class="service-content">
                <p class="eyebrow">
                  {service.number} / {service.name}
                </p>
                <h3><a href={service.href}>{service.name}</a></h3>
                <p>{service.text}</p>
                <ul class="tags">
                  {service.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
    <section
      class="approach section"
      id="approche"
      aria-labelledby="approach-title"
    >
      <div class="container approach-grid">
        <div class="approach-intro">
          <p class="eyebrow">02 / Notre approche</p>
          <h2 id="approach-title">
            On avance ensemble.
            <br />
            <span>À chaque étape.</span>
          </h2>
          <p class="section-copy">
            Du premier échange à la mise en ligne, vous parlez directement à la
            personne qui conçoit et développe votre projet.
          </p>
          <div class="approach-note">
            <MessagesSquare size={22} aria-hidden="true" />
            <p>
              <strong>Un interlocuteur. Un fil continu.</strong>
              <span>
                Des choix expliqués, des retours réguliers. Vous savez toujours
                où on en est.
              </span>
            </p>
          </div>
          <a
            class="text-link text-link-on-dark"
            href="mailto:bonjour@inlinea.fr"
          >
            Discutons de votre idée{" "}
            <ArrowUpRight size={18} aria-hidden="true" />
          </a>
        </div>
        <ol class="process-list">
          {steps.map((step, index) => (
            <li>
              <span class="process-number">0{index + 1}</span>
              <div class="process-content">
                <div class="process-heading">
                  <span class="eyebrow">{step.name}</span>
                  <step.icon size={21} aria-hidden="true" />
                </div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
                <div class="process-outcome">
                  <Check size={15} aria-hidden="true" />
                  <span>{step.outcome}</span>
                </div>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
    <section class="section studio" id="studio" aria-labelledby="studio-title">
      <div class="container studio-grid">
        <div class="studio-art" aria-hidden="true">
          <span class="map-coordinate">48°06′ N — 1°40′ O</span>
          <svg viewBox="0 0 540 370" fill="none">
            <g stroke="currentColor">
              <path
                d="M-30 90 180 155 275 120 400 165 570 140M-20 295 140 250 270 255 390 200 570 245M80-20 150 95 140 250 200 400M330-20 275 120 270 255 340 400M485-20 400 165 390 200 470 400"
                stroke-width="20"
              />
              <path
                d="m-20 170 180 25 100-15 180 75 110 5M210-20l-30 215 50 190"
                stroke-width="8"
              />
            </g>
            <path
              d="M-10 330C130 310 130 170 240 185S375 360 560 305"
              stroke="#93baff"
              stroke-width="14"
            />
          </svg>
          <div class="rennes-marker">
            <span class="map-dot"></span>
            <strong>
              Rennes<span>Notre point de départ.</span>
            </strong>
            <span class="marker-cross">
              <Asterisk size={20} aria-hidden="true" />
            </span>
          </div>
          <span class="map-caption">ANCRÉ EN BRETAGNE. CONNECTÉ PARTOUT.</span>
        </div>
        <div class="studio-copy">
          <p class="eyebrow">03 / Le studio</p>
          <h2 id="studio-title">
            L’esprit indépendant.
            <br />
            Le sens du collectif.
          </h2>
          <p>
            Inlinea est un studio de design et de développement basé à Rennes.
            Une structure à taille humaine, pour travailler ensemble,
            simplement.
          </p>
          <p>
            On accompagne les entreprises d’ici et d’ailleurs. À distance quand
            c’est plus simple, autour d’un café quand c’est mieux.
          </p>
          <a class="text-link" href="mailto:bonjour@inlinea.fr">
            Faisons connaissance <ArrowUpRight size={18} aria-hidden="true" />
          </a>
        </div>
      </div>
    </section>
    <section class="contact" id="contact" aria-labelledby="contact-title">
      <div class="container contact-inner">
        <span class="contact-star" aria-hidden="true">
          <Asterisk size={20} aria-hidden="true" />
        </span>
        <p class="eyebrow">La suite commence avec vous</p>
        <h2 id="contact-title">
          Une idée en tête ?<br />
          Faisons-en quelque chose.
        </h2>
        <p>
          Un brief précis ou une intuition sur un coin de carnet.
          <br />
          C’est tout ce qu’il faut pour commencer.
        </p>
        <a class="button button-white" href="mailto:bonjour@inlinea.fr">
          Parlons de votre projet <ArrowUpRight size={18} aria-hidden="true" />
        </a>
        <a class="contact-email" href="mailto:bonjour@inlinea.fr">
          bonjour@inlinea.fr
        </a>
      </div>
    </section>
  </main>
  <footer>
    <div class="container footer-main">
      <Brand />
      <p>
        Des idées claires. Des produits bien construits.
        <br />
        <span>Design & développement · Rennes, Bretagne</span>
      </p>
      <a class="text-link" href="#top">
        Retour en haut <ArrowUp size={18} aria-hidden="true" />
      </a>
    </div>
    <div class="container footer-bottom">
      <span>© {new Date().getFullYear()} Inlinea</span>
      <span>Indépendant par choix. Impliqué par nature.</span>
    </div>
  </footer>
</Layout>
