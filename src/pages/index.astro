---
import ContactPanel from "../components/ContactPanel.astro";
import Aurora from "../components/Aurora.astro";
import "../styles/home.css";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import {
  ArrowUpRight,
  ArrowDown,
  Asterisk,
  MousePointer2,
  Check,
  Lightbulb,
  MessagesSquare,
  PenTool,
  Code2,
  Pin,
  Plus,
} from "@lucide/astro";
const services = [
  {
    number: "01",
    type: "design",
    title: "Du sens. Et du caractère.",
    name: "Design produit",
    text: "Une identité reconnaissable, des interfaces claires et une expérience qui donne envie de revenir.",
    tags: ["Identité visuelle", "UI/UX", "Prototypage"],
    href: "/expertises/design-produit/",
  },
  {
    number: "02",
    type: "code",
    title: "Bien pensé. Bien développé.",
    name: "Sites & applications",
    text: "Du site vitrine à l’application web, des produits rapides, accessibles et simples à faire évoluer.",
    tags: ["Sites web", "Applications", "Développement"],
    href: "/expertises/sites-applications-web/",
  },
  {
    number: "03",
    type: "tools",
    title: "Moins de friction. Plus d’action.",
    name: "Outils sur mesure",
    text: "Des automatisations et des outils métier adaptés à votre quotidien. Pas l’inverse.",
    tags: ["Automatisation", "Google Sheets", "API"],
    href: "/expertises/outils-sur-mesure/",
  },
];
const faqs = [
  { question: "Par où commencer si mon idée n’est pas encore précise ?", answer: "Par un premier échange. Parlez-nous de votre activité, de ce que vous souhaitez améliorer et de vos premières idées. Le cadrage sert justement à préciser le besoin et à définir les priorités ensemble." },
  { question: "Pouvez-vous intervenir sur un site existant ?", answer: "Oui. Repenser une interface, faire évoluer un site ou simplifier un outil fait partie de nos expertises. On commence par regarder l’existant pour déterminer ce qui mérite d’être conservé ou retravaillé." },
  { question: "Quel budget et quel délai prévoir ?", answer: "Ils dépendent du périmètre, des fonctionnalités et des contenus à préparer. Le premier échange permet de clarifier ces éléments pour vous proposer un cadre adapté à votre projet." },
  { question: "Comment participe-t-on au projet ?", answer: "Vous échangez directement avec la personne qui conçoit et développe votre produit. Des premières pistes au prototype, puis à la mise en ligne, vos retours guident les décisions à chaque étape." },
  { question: "Faut-il être à Rennes pour travailler ensemble ?", answer: "Non. Le studio est basé à Rennes et accompagne les entreprises d’ici et d’ailleurs. On peut avancer à distance, ou se retrouver autour d’un café lorsque c’est possible." },
];
const steps = [
  {
    title: "On pose les bonnes questions.",
    name: "Cadrer",
    icon: MessagesSquare,
    outcome: "Un cap clair et des priorités partagées",
    text: "Votre besoin, vos utilisateurs, vos contraintes. On définit ensemble un cap clair et les priorités du projet.",
  },
  {
    title: "On donne forme à votre idée.",
    name: "Concevoir",
    icon: PenTool,
    outcome: "Un prototype pour se projeter",
    text: "Des premières pistes aux prototypes, vous voyez le projet prendre forme et participez aux choix.",
  },
  {
    title: "On construit pour la suite.",
    name: "Développer",
    icon: Code2,
    outcome: "Un produit testé, prêt à être utilisé",
    text: "On développe, on teste et on affine. Puis on met en ligne une solution que vous pouvez prendre en main.",
  },
];
---

<Layout
  title="Studio design & développement web à Rennes | Inlinea"
  description="Inlinea est un studio indépendant à Rennes. Design produit, création de sites et d’applications web, outils numériques sur mesure et automatisation."
>
  <a class="skip-link" href="#main">
    Aller au contenu
  </a>
  <Header />
  <main id="main" class="home">
    <section class="hero" aria-labelledby="hero-title">
      <Aurora />
      <div class="container hero-inner">
        <p class="eyebrow hero-eyebrow">
          <span class="small-cross" aria-hidden="true">
            <Asterisk size={20} aria-hidden="true" />
          </span>{" "}
          Studio indépendant · Rennes, Bretagne
        </p>
        <h1 id="hero-title">
          Studio de design & développement web à Rennes.
          <br />
          <span>Sans détour.</span>
        </h1>
        <p class="hero-description">
          Design, sites, applications et outils sur mesure.
          <br class="desktop-break" /> On donne vie à vos idées, avec du sens et
          du soin.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="mailto:bonjour@inlinea.fr">
            Construisons votre projet{" "}
            <ArrowUpRight size={18} aria-hidden="true" />
          </a>
          <a class="button button-secondary" href="#services">
            Explorer nos expertises <ArrowDown size={18} aria-hidden="true" />
          </a>
        </div>
        <div
          class="blueprint"
        >
          <div class="blueprint-meta">
            <span>INLINEA / DE L’IDÉE AU RÉEL</span>
            <span>DESIGN + CODE + UN PEU D’AUDACE</span>
          </div>
          <ol class="idea-path">
            <li><span class="idea-path-icon"><Lightbulb size={30} aria-hidden="true" /></span><span class="idea-path-number">01 / IMAGINER</span><strong>Votre idée.</strong></li>
            <li><span class="idea-path-icon"><PenTool size={30} aria-hidden="true" /></span><span class="idea-path-number">02 / CONSTRUIRE</span><strong>Notre savoir-faire.</strong></li>
            <li><span class="idea-path-icon"><Check size={30} aria-hidden="true" /></span><span class="idea-path-number">03 / LANCER</span><strong>Un produit qui vit.</strong></li>
          </ol>
        </div>
      </div>
    </section>
    <div class="expertise-strip">
      <div class="container">
        <span>De la réflexion à l’action.</span>
        <span>
          Design{" "}
          <i>
            <Asterisk size={20} aria-hidden="true" />
          </i>{" "}
          Développement{" "}
          <i>
            <Asterisk size={20} aria-hidden="true" />
          </i>{" "}
          Automatisation
        </span>
      </div>
    </div>
    <section
      class="section services"
      id="services"
      aria-labelledby="services-title"
    >
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">01 / Nos expertises</p>
            <h2 id="services-title">
              Les bonnes briques.
              <br />
              Le bon produit.
            </h2>
          </div>
          <p class="section-copy">
            Un site à lancer, une expérience à repenser, un quotidien à
            simplifier. On assemble ce qu’il vous faut, sans complexité inutile.
          </p>
        </div>
        <div class="service-grid">
          {services.map((service) => (
            <article class="service-card" data-reveal>
              <div class={`service-art art-${service.type}`} aria-hidden="true">
                {service.type === "design" ? (
                  <>
                    <div class="type-tile">
                      Aa<span>LE FOND + LA FORME</span>
                    </div>
                    <div class="color-tile">
                      <i></i>
                      <i></i>
                      <i></i>
                    </div>
                    <span class="art-cursor">
                      <MousePointer2 size={30} aria-hidden="true" />
                    </span>
                  </>
                ) : service.type === "code" ? (
                  <div class="code-tile">
                    <div>
                      <i></i>
                      <i></i>
                      <i></i>
                    </div>
                    <strong>
                      &lt;<span> / </span>&gt;
                    </strong>
                    <span>Une base solide.</span>
                  </div>
                ) : (
                  <div class="nodes">
                    <span>
                      <ArrowUpRight size={16} aria-hidden="true" />
                    </span>
                    <i></i>
                    <span>
                      <Asterisk size={20} aria-hidden="true" />
                    </span>
                    <i></i>
                    <span>
                      <Check size={26} aria-hidden="true" />
                    </span>
                    <small>Tout se connecte.</small>
                  </div>
                )}
              </div>
              <div class="service-content">
                <p class="eyebrow">
                  {service.number} / {service.name}
                </p>
                <h3><a href={service.href}>{service.title}<ArrowUpRight size={21} aria-hidden="true" /></a></h3>
                <p>{service.text}</p>
                <ul class="tags">
                  {service.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
    <section
      class="approach section"
      id="approche"
      aria-labelledby="approach-title"
    >
      <div class="container approach-grid">
        <div class="approach-intro">
          <p class="eyebrow">02 / Notre approche</p>
          <h2 id="approach-title">
            On avance ensemble.
            <br />
            <span>À chaque étape.</span>
          </h2>
          <p class="section-copy">
            Du premier échange à la mise en ligne, vous parlez directement à la
            personne qui conçoit et développe votre projet.
          </p>
          <div class="approach-note">
            <MessagesSquare size={22} aria-hidden="true" />
            <p>
              <strong>Un interlocuteur. Un fil continu.</strong>
              <span>
                Des choix expliqués, des retours réguliers. Vous savez toujours
                où on en est.
              </span>
            </p>
          </div>
          <a
            class="text-link"
            href="mailto:bonjour@inlinea.fr"
          >
            Discutons de votre idée{" "}
            <ArrowUpRight size={18} aria-hidden="true" />
          </a>
        </div>
        <div class="process-board">
          <svg class="process-thread" viewBox="0 0 600 1000" preserveAspectRatio="none" aria-hidden="true"><path d="M170 100 C590 130 570 320 360 420 S0 700 250 850" /></svg>
        <ol class="process-list">
          {steps.map((step, index) => (
            <li data-reveal>
              <Pin class="process-pin" size={22} aria-hidden="true" />
              <span class="process-number">0{index + 1}</span>
              <div class="process-content">
                <div class="process-heading">
                  <span class="eyebrow">{step.name}</span>
                  <step.icon size={21} aria-hidden="true" />
                </div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
                <div class="process-outcome">
                  <Check size={15} aria-hidden="true" />
                  <span>{step.outcome}</span>
                </div>
              </div>
            </li>
          ))}
        </ol>
        </div>
      </div>
    </section>
    <section class="section studio" id="studio" aria-labelledby="studio-title">
      <div class="container studio-grid">
        <div class="studio-art" data-reveal aria-hidden="true">
          <span class="map-coordinate">48°06′ N — 1°40′ O</span>
          <svg viewBox="0 0 540 370" fill="none">
            <g stroke="currentColor">
              <path
                d="M-30 90 180 155 275 120 400 165 570 140M-20 295 140 250 270 255 390 200 570 245M80-20 150 95 140 250 200 400M330-20 275 120 270 255 340 400M485-20 400 165 390 200 470 400"
                stroke-width="20"
              />
              <path
                d="m-20 170 180 25 100-15 180 75 110 5M210-20l-30 215 50 190"
                stroke-width="8"
              />
            </g>
            <path
              d="M-10 330C130 310 130 170 240 185S375 360 560 305"
              stroke="#93baff"
              stroke-width="14"
            />
          </svg>
          <div class="rennes-marker">
            <span class="map-dot"></span>
            <strong>
              Rennes<span>Notre point de départ.</span>
            </strong>
            <span class="marker-cross">
              <Asterisk size={20} aria-hidden="true" />
            </span>
          </div>
          <span class="map-caption">ANCRÉ EN BRETAGNE. CONNECTÉ PARTOUT.</span>
        </div>
        <div class="studio-copy">
          <p class="eyebrow">03 / Le studio</p>
          <h2 id="studio-title">
            L’esprit indépendant.
            <br />
            Le sens du collectif.
          </h2>
          <p>
            Inlinea est un studio de design et de développement basé à Rennes.
            Une structure à taille humaine, pour travailler ensemble,
            simplement.
          </p>
          <p>
            On accompagne les entreprises d’ici et d’ailleurs. À distance quand
            c’est plus simple, autour d’un café quand c’est mieux.
          </p>
          <a class="text-link" href="mailto:bonjour@inlinea.fr">
            Faisons connaissance <ArrowUpRight size={18} aria-hidden="true" />
          </a>
        </div>
      </div>
    </section>
    <section class="section faq" aria-labelledby="faq-title">
      <div class="container">
        <div class="faq-heading">
          <p class="eyebrow">04 / Quelques réponses</p>
          <h2 id="faq-title">Tout commence<br />par une question.</h2>
          <p class="section-copy">Les premières réponses, juste ici. Pour la suite,<br class="desktop-break" /> écrivez-nous à <a href="mailto:bonjour@inlinea.fr">bonjour@inlinea.fr</a>.</p>
        </div>
        <div class="faq-list">
          {faqs.map((faq, index) => (
            <details class="faq-item" name="project-faq">
              <summary><span class="faq-number" aria-hidden="true">0{index + 1}</span><span>{faq.question}</span><Plus size={22} aria-hidden="true" /></summary>
              <div class="faq-answer"><p>{faq.answer}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>
    <section class="contact" id="contact" aria-labelledby="contact-title">
      <div class="container">
        <ContactPanel title="Une idée en tête ? Faisons-en quelque chose." description="Un brief précis ou une intuition sur un coin de carnet. C’est tout ce qu’il faut pour commencer." showStudioLink>
          <Fragment slot="title">Une idée en tête ?<br />Faisons-en quelque chose.</Fragment>
        </ContactPanel>
      </div>
    </section>
  </main>

</Layout>

<script>
  const board = document.querySelector<HTMLElement>('.process-board');
  const thread = board?.querySelector('svg');
  const path = thread?.querySelector('path');
  if (board && thread && path) {
    const cards = Array.from(board.querySelectorAll<HTMLElement>('li'));
    const updateThread = () => {
      const width = board.clientWidth;
      thread.setAttribute('viewBox', `0 0 ${width} ${board.clientHeight}`);
      path.setAttribute('d', cards.slice(0, -1).map((card, index) => {
        const next = cards[index + 1];
        const x1 = card.offsetLeft + card.offsetWidth / 2 + 12;
        const y1 = card.offsetTop + card.offsetHeight + 20;
        const x2 = next.offsetLeft + next.offsetWidth / 2 + 12;
        const y2 = next.offsetTop + 20;
        const middle = (y1 + y2) / 2;
        const bend = index % 2 === 0 ? width - 15 : 15;
        return `M ${x1} ${y1} C ${x1} ${middle}, ${bend} ${middle}, ${x2} ${y2}`;
      }).join(' '));
    };
    const resize = new ResizeObserver(updateThread);
    resize.observe(board);
    cards.forEach(card => resize.observe(card));
  }
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const elements = document.querySelectorAll<HTMLElement>('[data-reveal]');
  const observer = new IntersectionObserver(entries => {
    for (const entry of entries) {
      if (!entry.isIntersecting) continue;
      if (!reduce.matches) entry.target.animate([
        { opacity: 0, translate: '0 18px' },
        { opacity: 1, translate: '0 0' }
      ], { duration: 600, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' });
      observer.unobserve(entry.target);
    }
  }, { threshold: 0.12 });
  elements.forEach(element => observer.observe(element));
  reduce.addEventListener('change', () => {
    if (reduce.matches) elements.forEach(element => element.getAnimations().forEach(animation => animation.cancel()));
  });
</script>
